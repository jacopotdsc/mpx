+    w_, x_, y_, z_ = q
+    roll = np.arctan2(2 * (w_ * x_ + y_ * z_), 1 - 2 * (x_ * x_ + y_ * y_))
+    pitch = np.arcsin(np.clip(2 * (w_ * y_ - z_ * x_), -1.0, 1.0))
+    yaw = np.arctan2(2 * (w_ * z_ + x_ * y_), 1 - 2 * (y_ * y_ + z_ * z_))
+    return roll, pitch, yaw
